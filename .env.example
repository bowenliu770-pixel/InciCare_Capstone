# ==============================================================================
# InciCare — Environment Variables Template
# Copy this file to '.env' and customize values as needed.
# ==============================================================================

# --- Server Configuration ---
PORT=5262
HOST=0.0.0.0

# --- Telegram Alert Notifications ---
# Critical (Tier 1) incidents trigger instant alerts to this Telegram bot / chat
TELEGRAM_BOT_TOKEN=8696134301:AAEjs46Uqote89h4wQShKbN5rbiHxXpuumo
TELEGRAM_CHAT_ID=6856567076

# --- Ollama AI Configuration ---
# Model runs locally via Ollama (https://ollama.com) with 100% privacy and zero API fees
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# --- Incident Map Tile Provider ---
# Default is OpenStreetMap which is 100% free and requires NO API KEY.
# Default: https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional: If you use a custom tile provider that requires an API key (e.g. Mapbox, Stadia, Carto, Maptiler)
# Example Mapbox: https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/{z}/{x}/{y}?access_token={apiKey}
# Example Stadia: https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png?api_key={apiKey}
MAP_API_KEY=
